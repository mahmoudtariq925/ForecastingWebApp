# ============================================================
# LIVE instance configuration (`npm run build:live`).
#
# Loaded by Vite only when building with `--mode live`; the
# default static/demo build never reads this file, so nothing
# here can affect the demo deployment. All values are baked in
# at build time and are PUBLIC (they ship in the JS bundle) —
# never put secrets in any VITE_ variable.
# ============================================================

# Switches the app off mock data: no demo users, entities or numbers.
VITE_DATA_SOURCE=live

# The bootstrap administrator the live instance starts with. Sign in
# happens via the user switcher until Phase 3 SSO; this account then
# creates the real users in User Management.
VITE_ADMIN_NAME=Administrator
VITE_ADMIN_EMAIL=mahmoudtariq925@gmail.com
